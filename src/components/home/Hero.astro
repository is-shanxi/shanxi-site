---
/**
 * 首页 Hero —— 古典洛丽塔主视觉（grill-me 第 6 轮定）。
 *
 * 视觉层次（全部用 SVG 与 CSS 实现，零外图依赖）：
 *   1. 深海军渐变背 + 顶/底三层径向光斑，模拟水晶吊灯氛围
 *   2. 左/右两列金色卷草幕布（inline SVG，~1.4KB）
 *   3. 顶部徽记：水晶吊灯 SVG + 两侧鎏金卷草分隔线（火苗微光闪烁）
 *   4. 文案：问候 + Playfair Display 衬线大标题 + 打字机标语 + CTA
 *      CTA 三枚：鎏金描边主按钮（hover 微光扫过）/ 幽灵按钮 / GitHub 社交按钮
 *
 * Header 自带毛玻璃，自然浮于 Hero 之上；
 * 用 padding 把内容推到 Header 下方。
 */
import Icon from '@/components/ui/Icon.astro';
import { AUTHOR, SITE, SOCIALS } from '@/config';
import { useTranslations } from '@/i18n';
import { greetingKey } from '@/lib/utils';

const t = useTranslations();
const greeting = t(greetingKey());
const github = SOCIALS.find((s) => s.key === 'github');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    {/* 三层金色吊灯光斑 */}
    <span class="glow glow-1"></span>
    <span class="glow glow-2"></span>
    <span class="glow glow-3"></span>

    {/* 左/右两列金色卷草幕布柱 */}
    <svg class="col col-l" viewBox="0 0 80 800" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="hGoldL" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="var(--gold-hover)" stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color="var(--gold)" stop-opacity="0.2"></stop>
        </linearGradient>
      </defs>
      <rect width="2" height="800" x="20" fill="url(#hGoldL)"></rect>
      <g fill="var(--gold)" opacity="0.78">
        <circle cx="21" cy="40" r="4"></circle>
        <circle cx="21" cy="120" r="3"></circle>
        <circle cx="21" cy="200" r="4"></circle>
        <circle cx="21" cy="280" r="3"></circle>
        <circle cx="21" cy="380" r="5"></circle>
        <circle cx="21" cy="500" r="3"></circle>
        <circle cx="21" cy="600" r="4"></circle>
        <circle cx="21" cy="700" r="3"></circle>
        <path d="M14 30 q7 4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
        <path d="M28 110 q7 -4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
        <path d="M14 270 q7 4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
        <path d="M28 410 q7 -4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
        <path d="M14 590 q7 4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
      </g>
    </svg>
    <svg class="col col-r" viewBox="0 0 80 800" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="hGoldR" x1="1" y1="0" x2="0" y2="0">
          <stop offset="0%" stop-color="var(--gold-hover)" stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color="var(--gold)" stop-opacity="0.2"></stop>
        </linearGradient>
      </defs>
      <rect width="2" height="800" x="58" fill="url(#hGoldR)"></rect>
      <g fill="var(--gold)" opacity="0.78">
        <circle cx="59" cy="40" r="4"></circle>
        <circle cx="59" cy="120" r="3"></circle>
        <circle cx="59" cy="200" r="4"></circle>
        <circle cx="59" cy="280" r="3"></circle>
        <circle cx="59" cy="380" r="5"></circle>
        <circle cx="59" cy="500" r="3"></circle>
        <circle cx="59" cy="600" r="4"></circle>
        <circle cx="59" cy="700" r="3"></circle>
        <path d="M66 30 q7 4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
        <path d="M52 110 q7 -4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
        <path d="M66 270 q7 4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
        <path d="M52 410 q7 -4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
        <path d="M66 590 q7 4 14 0 q-7 6 -14 0 z" opacity="0.6"></path>
      </g>
    </svg>

    {/* 顶部细纹饰：金色卷草 */}
    <svg class="filigree filigree-top" viewBox="0 0 600 28" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M0 14 Q150 0 300 14 T600 14 M0 14 Q150 28 300 14 T600 14"
        fill="none"
        stroke="var(--gold)"
        stroke-width="1"
        opacity="0.6"></path>
      <circle cx="300" cy="14" r="3" fill="var(--gold)" opacity="0.85"></circle>
      <circle cx="120" cy="14" r="1.5" fill="var(--gold)" opacity="0.7"></circle>
      <circle cx="480" cy="14" r="1.5" fill="var(--gold)" opacity="0.7"></circle>
    </svg>

    {/* 底部细纹饰：金色卷草 */}
    <svg class="filigree filigree-bottom" viewBox="0 0 600 28" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M0 14 Q150 0 300 14 T600 14 M0 14 Q150 28 300 14 T600 14"
        fill="none"
        stroke="var(--gold)"
        stroke-width="1"
        opacity="0.6"></path>
      <circle cx="300" cy="14" r="3" fill="var(--gold)" opacity="0.85"></circle>
    </svg>

    </div>

  <div class="hero-inner">
    <div class="hero-copy">
      {/* 顶部徽记：水晶吊灯 + 两侧鎏金卷草分隔线（呼应女仆工坊水晶吊灯设定） */}
      <div class="hero-crest" aria-hidden="true">
        <svg class="crest-line crest-line-l" viewBox="0 0 200 14" preserveAspectRatio="none">
          <defs>
            <linearGradient id="crestFadeL" x1="1" y1="0" x2="0" y2="0">
              <stop offset="0%" stop-color="var(--gold)" stop-opacity="0.95"></stop>
              <stop offset="70%" stop-color="var(--gold)" stop-opacity="0.45"></stop>
              <stop offset="100%" stop-color="var(--gold)" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path d="M196 7 C 150 3 70 11 16 7" fill="none" stroke="url(#crestFadeL)" stroke-width="1.2"></path>
          <path d="M8 7 L13 3.2 L18 7 L13 10.8 Z" fill="var(--gold)" opacity="0.85"></path>
          <circle cx="24" cy="7" r="1.3" fill="var(--gold)" opacity="0.6"></circle>
        </svg>

        <svg class="crest-svg" viewBox="0 0 96 62">
          {/* 吊链与顶座 */}
          <circle cx="48" cy="4" r="2.2" fill="var(--gold)"></circle>
          <line x1="48" y1="6" x2="48" y2="13" stroke="var(--gold)" stroke-width="1.2"></line>
          <path d="M39 14 Q48 9 57 14" fill="none" stroke="var(--gold)" stroke-width="1.2"></path>
          <line x1="48" y1="14" x2="48" y2="24" stroke="var(--gold)" stroke-width="1.2"></line>
          {/* 双层灯臂 */}
          <path d="M48 24 C 40 24 30 26 22 33" fill="none" stroke="var(--gold)" stroke-width="1.1"></path>
          <path d="M48 24 C 56 24 66 26 74 33" fill="none" stroke="var(--gold)" stroke-width="1.1"></path>
          <path d="M48 27 C 44 28 41 30 38 35" fill="none" stroke="var(--gold)" stroke-width="1"></path>
          <path d="M48 27 C 52 28 55 30 58 35" fill="none" stroke="var(--gold)" stroke-width="1"></path>
          {/* 烛台 + 火苗（火苗有微光闪烁） */}
          <ellipse cx="22" cy="34" rx="2.2" ry="2.6" fill="var(--gold)"></ellipse>
          <ellipse cx="74" cy="34" rx="2.2" ry="2.6" fill="var(--gold)"></ellipse>
          <ellipse cx="38" cy="36" rx="2" ry="2.4" fill="var(--gold)"></ellipse>
          <ellipse cx="58" cy="36" rx="2" ry="2.4" fill="var(--gold)"></ellipse>
          <circle class="crest-flame" cx="22" cy="29.5" r="1.4" fill="#f6e7bd"></circle>
          <circle class="crest-flame" cx="74" cy="29.5" r="1.4" fill="#f6e7bd"></circle>
          <circle class="crest-flame" cx="38" cy="31.5" r="1.2" fill="#f6e7bd"></circle>
          <circle class="crest-flame" cx="58" cy="31.5" r="1.2" fill="#f6e7bd"></circle>
          {/* 水晶坠（菱形泪滴） */}
          <path d="M22 37.5 l3 5 -3 7 -3 -7 z" fill="var(--gold)" opacity="0.75"></path>
          <path d="M74 37.5 l3 5 -3 7 -3 -7 z" fill="var(--gold)" opacity="0.75"></path>
          <path d="M38 39.5 l2.6 4.4 -2.6 6.2 -2.6 -6.2 z" fill="var(--gold)" opacity="0.65"></path>
          <path d="M58 39.5 l2.6 4.4 -2.6 6.2 -2.6 -6.2 z" fill="var(--gold)" opacity="0.65"></path>
          <path d="M48 31 l4 7.5 -4 9.5 -4 -7.5 z" fill="var(--gold)" opacity="0.85"></path>
          <path d="M42 44 L48 48.5 L54 44" fill="none" stroke="var(--gold)" stroke-width="0.9" opacity="0.5"></path>
        </svg>

        <svg class="crest-line crest-line-r" viewBox="0 0 200 14" preserveAspectRatio="none">
          <defs>
            <linearGradient id="crestFadeR" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--gold)" stop-opacity="0.95"></stop>
              <stop offset="70%" stop-color="var(--gold)" stop-opacity="0.45"></stop>
              <stop offset="100%" stop-color="var(--gold)" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path d="M4 7 C 50 3 130 11 184 7" fill="none" stroke="url(#crestFadeR)" stroke-width="1.2"></path>
          <path d="M192 7 L187 3.2 L182 7 L187 10.8 Z" fill="var(--gold)" opacity="0.85"></path>
          <circle cx="176" cy="7" r="1.3" fill="var(--gold)" opacity="0.6"></circle>
        </svg>
      </div>

      <p class="hero-greeting">
        <span class="greet-dot" aria-hidden="true"></span>
        {greeting}，欢迎来到
      </p>

      <h1 id="hero-title" class="hero-title">
        {SITE.title}
        <span class="hero-handle">@{AUTHOR.handle}</span>
      </h1>

      <p class="hero-tagline">
        <span
          class="type-text"
          data-typewriter={JSON.stringify(AUTHOR.taglines)}>{AUTHOR.taglines[0]}</span
        ><span class="type-caret" aria-hidden="true"></span>
      </p>

      <p class="hero-bio">{SITE.description}</p>

      <div class="hero-actions">
        <a class="btn btn-coral btn-hero-main" href="/blog">
          <Icon name="book" size={16} />
          读读文章
        </a>
        <a class="btn btn-hero-ghost" href="/about">
          <Icon name="user" size={16} />
          认识我
        </a>
        {github && (
          <a
            class="btn btn-hero-social"
            href={github.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" size={16} />
            GitHub
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<div class="ribbon-divider" aria-hidden="true">
  <svg viewBox="0 0 32 16" width="44" height="22" fill="none">
    <path
      d="M2 8 L8 4 L8 12 Z M30 8 L24 4 L24 12 Z M10 6 Q16 2 22 6 Q16 10 22 14 Q10 14 10 6 Z"
      fill="var(--gold)"></path>
    <circle cx="16" cy="8" r="1.4" fill="var(--bg)"></circle>
  </svg>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-block-size: clamp(24rem, 70vh, 36rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: calc(var(--header-h) + clamp(2.5rem, 7vh, 4.5rem)) clamp(4rem, 9vh, 6rem);
    border-block-end: 1px solid var(--border-strong);
  }

  /* ── 背景层：纯 SVG+CSS ─────────── */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        170deg,
        #305890 0%,
        #1c3a6b 28%,
        #0f2040 62%,
        #0b1830 100%
      );
  }

  /* 三层金色吊灯光斑 */
  .hero-bg .glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(60px);
  }
  .glow-1 {
    inset-block-start: -10%;
    inset-inline-start: -8%;
    inline-size: 28rem;
    block-size: 28rem;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in oklab, var(--gold) 56%, transparent) 0%,
      transparent 65%
    );
  }
  .glow-2 {
    inset-block-start: -10%;
    inset-inline-end: -8%;
    inline-size: 30rem;
    block-size: 30rem;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in oklab, var(--gold) 50%, transparent) 0%,
      transparent 65%
    );
  }
  .glow-3 {
    inset-block-end: -25%;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 36rem;
    block-size: 22rem;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in oklab, var(--brand) 36%, transparent) 0%,
      transparent 70%
    );
  }

  /* 左右两列金色幕布柱 */
  .col {
    position: absolute;
    inset-block: 0;
    inline-size: 80px;
    block-size: 100%;
    pointer-events: none;
  }
  .col-l { inset-inline-start: 0; opacity: 0.85; }
  .col-r { inset-inline-end: 0;  opacity: 0.85; }

  /* 顶部/底部细纹饰 */
  .filigree {
    position: absolute;
    inset-inline: 0;
    block-size: 28px;
    pointer-events: none;
    opacity: 0.9;
  }
  .filigree-top    { inset-block-start: 6px; }
  .filigree-bottom { inset-block-end: 6px; }

  /* ── 内容 ─────────────────────────────── */
  .hero-inner {
    inline-size: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.2rem);
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-copy {
    max-inline-size: 42rem;
    margin-inline: auto;
    text-shadow: 0 2px 8px rgb(8 18 46 / 0.4);
  }

  /* ── 顶部徽记：水晶吊灯 + 卷草分隔线 ── */
  .hero-crest {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1.6vw, 1rem);
    margin-block-end: 1.15rem;
  }
  .crest-svg {
    inline-size: clamp(58px, 8vw, 88px);
    block-size: auto;
    flex: none;
    opacity: 0.95;
    filter: drop-shadow(0 2px 10px rgb(197 164 104 / 0.4));
  }
  .crest-line {
    inline-size: clamp(64px, 14vw, 168px);
    block-size: 14px;
    flex: none;
    opacity: 0.85;
  }
  .crest-flame {
    animation: twinkle 2.8s var(--ease-soft) infinite;
  }
  .crest-flame + .crest-flame { animation-delay: 0.7s; }
  @keyframes twinkle {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.45; }
  }

  .hero-greeting {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.85rem;
    padding: 0.3rem 0.85rem 0.3rem 0.7rem;
    font-size: 0.86rem;
    font-weight: 580;
    color: #ddd0b0;
    background: color-mix(in oklab, var(--gold-soft) 18%, transparent);
    border: 1px solid color-mix(in oklab, var(--gold) 42%, transparent);
    border-radius: var(--r-full);
    letter-spacing: 0.02em;
    backdrop-filter: blur(8px);
    justify-content: center;
  }
  .greet-dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--gold) 28%, transparent);
    animation: pulse-dot 2.4s var(--ease-soft) infinite;
  }
  @keyframes pulse-dot {
    50% {
      box-shadow: 0 0 0 7px color-mix(in oklab, var(--gold) 10%, transparent);
    }
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 6.4vw, 4rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.005em;
    color: #f8f5f0;
    background: linear-gradient(180deg, #fdfbf7 0%, #ddd0b0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-handle {
    display: inline-block;
    margin-inline-start: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: color-mix(in oklab, var(--gold) 80%, transparent);
    -webkit-text-fill-color: color-mix(in oklab, var(--gold) 80%, transparent);
    vertical-align: middle;
  }

  .hero-tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.85rem 0 0;
    min-block-size: 1.9rem;
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    font-weight: 540;
    /* hero 段背景恒深（.hero-bg 是固定深蓝渐变，不跟随主题），
       字色也必须主题无关：偏金米白以呼应鎏金调 */
    color: #e9dfc8;
    font-style: italic;
  }
  .type-caret {
    display: inline-block;
    inline-size: 2px;
    block-size: 1.15em;
    margin-inline-start: 3px;
    background: var(--gold);
    box-shadow: 0 0 6px color-mix(in oklab, var(--gold) 50%, transparent);
    animation: blink 1.05s steps(2, start) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero-bio {
    max-width: 36rem;
    margin: 0.9rem auto 0;
    font-size: 0.96rem;
    line-height: 1.85;
    /* hero 段背景恒深，字色恒亮：偏冷的瓷白以与金米 tagline 形成层次 */
    color: #c9d3e8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-block-start: 1.7rem;
    justify-content: center;
  }

  /* 主按钮升级：鎏金描边 + hover 微光扫过 */
  .btn-hero-main {
    position: relative;
    overflow: hidden;
    border-color: color-mix(in oklab, var(--gold) 62%, transparent);
    box-shadow:
      0 8px 18px -8px var(--coral-ring),
      0 0 0 1px color-mix(in oklab, var(--gold) 28%, transparent),
      0 0 22px -6px var(--gold-ring);
  }
  .btn-hero-main::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 32%,
      rgb(255 246 222 / 0.55) 50%,
      transparent 68%
    );
    translate: -130% 0;
    transition: translate 0.75s var(--ease-soft);
  }
  .btn-hero-main:hover::after {
    translate: 130% 0;
  }
  .btn-hero-main:hover {
    border-color: var(--gold-hover);
    box-shadow:
      0 12px 26px -8px var(--coral-ring),
      0 0 0 1px var(--gold-hover),
      0 0 30px -6px var(--gold-ring);
  }

  /* GitHub 社交按钮：与幽灵按钮同族，鎏金细描边 */
  .btn-hero-social {
    background: color-mix(in oklab, white 6%, transparent);
    color: #dfe6f3;
    border: 1px solid color-mix(in oklab, var(--gold) 45%, transparent);
    backdrop-filter: blur(8px);
  }
  .btn-hero-social:hover {
    border-color: var(--gold);
    color: #fdfbf7;
    background: color-mix(in oklab, var(--gold-soft) 14%, transparent);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -10px var(--gold-ring);
  }

  /* Hero 内的幽灵按钮：深海图上用浅色描边/文字 */
  .btn-hero-ghost {
    background: color-mix(in oklab, white 8%, transparent);
    color: #f8f5f0;
    border: 1px solid color-mix(in oklab, var(--gold) 60%, transparent);
    backdrop-filter: blur(8px);
  }
  .btn-hero-ghost:hover {
    border-color: var(--gold);
    color: #fdfbf7;
    background: color-mix(in oklab, var(--gold-soft) 18%, transparent);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -10px var(--gold-ring);
  }

  /* ── 响应式 ───────────────────────────── */
  @media (max-width: 900px) {
    .hero {
      min-block-size: clamp(24rem, 78vh, 32rem);
      padding-block: calc(var(--header-h) + 1.8rem) 3rem;
    }
    .col { inline-size: 50px; opacity: 0.65; }
    .glow-1 { inline-size: 18rem; block-size: 18rem; }
    .glow-2 { inline-size: 20rem; block-size: 20rem; }
    .crest-line { inline-size: clamp(44px, 12vw, 90px); }
    .hero-crest { margin-block-end: 0.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .greet-dot,
    .type-caret,
    .crest-flame {
      animation: none !important;
    }
  }
</style>
