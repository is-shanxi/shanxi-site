---
/**
 * 左侧栏底部：站点小统计。
 * 文章 / 碎碎念 / 作品 / 运行天数，纯展示，给 sidebar 一个收尾的重量感。
 */
import Icon from '@/components/ui/Icon.astro';
import { SITE } from '@/config';
import { useTranslations } from '@/i18n';
import { daysSince } from '@/lib/utils';

interface Props {
  stats: { posts: number; notes: number; projects: number; words: number };
}

const { stats } = Astro.props;
const t = useTranslations();

const days = daysSince(SITE.since);

const items = [
  { icon: 'book' as const, value: stats.posts, label: t('sidebar.stats.posts') },
  { icon: 'note' as const, value: stats.notes, label: t('sidebar.stats.notes') },
  { icon: 'sparkles' as const, value: stats.projects, label: t('sidebar.stats.projects') },
  { icon: 'calendar' as const, value: days, label: t('sidebar.stats.days') },
];
---

<div class="card card-solid stats reveal">
  <h3 class="section-title stats-title">
    <Icon name="database" size={16} />
    {t('sidebar.stats')}
  </h3>
  <div class="stats-grid">
    {
      items.map((it) => (
        <div class="stat-tile">
          <span class="stat-value">{it.value}</span>
          <span class="stat-label">{it.label}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .stats {
    padding: 1rem 1.1rem 1.1rem;
  }
  .stats-title {
    font-size: 0.95rem;
    margin-block-end: 0.7rem;
  }
  .stats-title :global(svg) {
    color: var(--brand);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }
  .stat-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.6rem 0.4rem;
    border-radius: var(--r-sm);
    background: var(--bg-soft);
    border: 1px solid var(--border);
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--brand);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 0.74rem;
    color: var(--text-subtle);
  }
</style>
