---
/**
 * 右侧栏：运行状态（运行时长 + 最后活动）。
 * Firefly 风格的 info-row 卡片：图标+标签在左，大数字在右。
 */
import Icon from '@/components/ui/Icon.astro';
import { useTranslations } from '@/i18n';
import { daysSince } from '@/lib/utils';

interface Props {
  since: number;
  lastPostDate?: Date;
}

const { since, lastPostDate } = Astro.props;
const t = useTranslations();

const uptime = daysSince(since);
const lastDays = lastPostDate
  ? Math.max(0, Math.floor((Date.now() - lastPostDate.getTime()) / 86_400_000))
  : null;

const rows = [
  {
    icon: 'clock' as const,
    label: t('sidebar.runtime.uptime'),
    value: `${uptime} ${t('sidebar.unit.day')}`,
  },
  {
    icon: 'calendar' as const,
    label: t('sidebar.runtime.lastActive'),
    value: lastDays !== null ? t('sidebar.unit.daysAgo', { n: lastDays }) : '-',
  },
];
---

<div class="card card-solid ff-card runtime-card reveal">
  <h3 class="section-title ff-title">
    <Icon name="clock" size={16} />
    {t('sidebar.runtime')}
  </h3>

  <div class="ff-body">
    {
      rows.map((row) => (
        <div class="ff-row">
          <span class="ff-row-label">
            <Icon name={row.icon} size={15} />
            {row.label}
          </span>
          <span class="ff-row-value">{row.value}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .runtime-card {
    padding: 0;
    /* 取消 overflow:hidden，避免父级裁剪行内容 */
  }
  .ff-title {
    padding: 1rem 1.1rem 0.85rem;
  }
  .ff-body {
    display: flex;
    flex-direction: column;
  }
  .ff-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 0.8rem;
    padding: 0.85rem 1.1rem;
    border-block-start: 1px solid var(--border);
    /* 让子元素可以收缩而不撑破行 */
    min-width: 0;
  }
  .ff-row-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.84rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .ff-row-label :global(svg) {
    color: var(--brand);
    opacity: 0.85;
    flex: none;
  }
  .ff-row-value {
    /*
      允许 value 在极窄时收缩，但绝不允许换行；
      过长时显示省略号，而不是被父级 overflow:hidden 裁掉或挤出容器。
    */
    flex: 0 1 auto;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    text-align: end;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;
    max-width: none;
  }
</style>
