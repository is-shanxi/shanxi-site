---
import type { IconName } from '@/config';

/**
 * 内联 SVG 图标。
 *
 * 刻意不引入 astro-icon / iconify —— 图标数量可控（约 30 个），
 * 内联可以省掉一个依赖和一次网络请求，且完全掌控描边风格。
 * 全部采用 round 端点与 1.75 描边，服务于"治愈系圆润"的视觉基调。
 */
interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  /** 语义化标签；不传则视为装饰性图标并对辅助技术隐藏 */
  label?: string;
  strokeWidth?: number;
}

const {
  name,
  size = 18,
  class: className = '',
  label,
  strokeWidth = 1.75,
} = Astro.props;

/** 路径集合：全部基于 24×24 视窗 */
const PATHS: Record<IconName, string> = {
  home: '<path d="M3 10.2 12 3l9 7.2"/><path d="M5.5 9.3V20a1 1 0 0 0 1 1H10v-5.5h4V21h3.5a1 1 0 0 0 1-1V9.3"/>',
  book: '<path d="M4 4.6A1.6 1.6 0 0 1 5.6 3H10a3 3 0 0 1 2 5.2V21a3 3 0 0 0-2-.9H5.6A1.6 1.6 0 0 1 4 18.5z"/><path d="M20 4.6A1.6 1.6 0 0 0 18.4 3H14a3 3 0 0 0-2 5.2V21a3 3 0 0 1 2-.9h4.4a1.6 1.6 0 0 0 1.6-1.6z"/>',
