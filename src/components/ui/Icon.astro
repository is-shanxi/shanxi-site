  tag: '<path d="M11.6 3.4 20 11.8a1.8 1.8 0 0 1 0 2.5l-5.7 5.7a1.8 1.8 0 0 1-2.5 0L3.4 11.6V5.2a1.8 1.8 0 0 1 1.8-1.8z"/><circle cx="8" cy="8" r="1.4"/>',
  archive:
    '<rect x="3" y="4" width="18" height="4.4" rx="1.6"/><path d="M4.8 8.4V19a2 2 0 0 0 2 2h10.4a2 2 0 0 0 2-2V8.4"/><path d="M10 12.4h4"/>',
  search:
    '<circle cx="10.8" cy="10.8" r="6.4"/><path d="m15.6 15.6 4 4"/>',
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"/>',
  moon: '<path d="M20.2 14.2A8.4 8.4 0 0 1 9.8 3.8a8.4 8.4 0 1 0 10.4 10.4"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h10"/>',
