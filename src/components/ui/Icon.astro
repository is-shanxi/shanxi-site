    '<path d="M9 19.2c-4.4 1.3-4.4-2.3-6.2-2.8m12.4 5.1v-3.5a3 3 0 0 0-.85-2.35c2.85-.32 5.85-1.4 5.85-6.35a4.9 4.9 0 0 0-1.4-3.4 4.6 4.6 0 0 0-.1-3.45s-1.1-.32-3.6 1.36a12.4 12.4 0 0 0-6.5 0C6.15 2.15 5.05 2.47 5.05 2.47a4.6 4.6 0 0 0-.1 3.45 4.9 4.9 0 0 0-1.4 3.43c0 4.9 3 5.98 5.85 6.33A3 3 0 0 0 8.55 18v3.5"/>',
