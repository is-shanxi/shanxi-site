---
/**
 * 上浮金粉背景（古典洛丽塔氛围粒子）。
 *
 * 由萤火虫粒子改造而来：粒子自页面底部缓慢上升、轻微左右摆动，
 * 模拟维多利亚式金箔粉末上浮。纯 CSS 实现，只动 transform 与 opacity，
 * 全程走合成线程，不触发重排重绘。
 * 位置与时长在构建期确定（非随机），保证每次构建输出稳定、可缓存。
 */
const COUNT = 16;

// 手工调过的分布：横向铺开、纵向错落，避免聚堆
const PARTICLES = [
  { x: 4, y: 96, s: 10, d: 26, delay: 0, sway: 30 },
  { x: 11, y: 104, s: 6, d: 32, delay: -7, sway: -24 },
  { x: 18, y: 92, s: 13, d: 29, delay: -14, sway: 36 },
  { x: 26, y: 108, s: 7, d: 35, delay: -4, sway: -32 },
  { x: 33, y: 95, s: 11, d: 27, delay: -19, sway: 26 },
  { x: 41, y: 102, s: 6, d: 33, delay: -9, sway: -28 },
  { x: 48, y: 93, s: 14, d: 25, delay: -16, sway: 34 },
  { x: 55, y: 106, s: 8, d: 31, delay: -22, sway: -30 },
  { x: 62, y: 97, s: 10, d: 28, delay: -6, sway: 24 },
  { x: 69, y: 104, s: 6, d: 34, delay: -12, sway: -34 },
  { x: 76, y: 92, s: 12, d: 26, delay: -18, sway: 30 },
  { x: 83, y: 108, s: 7, d: 33, delay: -3, sway: -26 },
  { x: 89, y: 96, s: 11, d: 29, delay: -13, sway: 32 },
  { x: 95, y: 102, s: 8, d: 31, delay: -8, sway: -28 },
  { x: 51, y: 112, s: 9, d: 36, delay: -24, sway: 26 },
  { x: 30, y: 112, s: 5, d: 38, delay: -28, sway: -22 },
].slice(0, COUNT);
---

<div class="dust" aria-hidden="true">
  {
    PARTICLES.map((p) => (
      <span
        class="dust-p"
        style={`
          --x: ${p.x}%;
          --y: ${p.y}%;
          --size: ${p.s}px;
          --dur: ${p.d}s;
          --delay: ${p.delay}s;
          --sway: ${p.sway}px;
        `}
      />
    ))
  }
</div>

<style>
  .dust {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* 中部最亮，边缘淡出，避免干扰内容阅读 */
    mask-image: radial-gradient(
      120% 95% at 50% 40%,
      #000 20%,
      rgb(0 0 0 / 0.4) 65%,
      transparent 100%
    );
  }

  .dust-p {
    position: absolute;
    inset-block-start: var(--y);
    inset-inline-start: var(--x);
    inline-size: var(--size);
    block-size: var(--size);
    border-radius: 50%;
    /* 金粉质感：高光 + 半透明 + 细描边 */
    background: radial-gradient(
      circle at 32% 30%,
      rgb(255 250 230 / 0.95),
      color-mix(in oklab, var(--gold) 60%, transparent) 55%,
      transparent 72%
    );
    border: 1px solid color-mix(in oklab, var(--gold) 50%, transparent);
    box-shadow:
      inset 0 0 6px color-mix(in oklab, var(--gold-soft) 60%, transparent),
      0 0 12px color-mix(in oklab, var(--gold) 36%, transparent);
    opacity: 0;
    animation: dust-rise var(--dur) var(--delay) infinite linear;
    will-change: transform, opacity;
  }

  /* 自底部上升，左右轻微摆动，顶部落出视野并隐去 */
  @keyframes dust-rise {
    0% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
    }
    8% {
      opacity: 0.62;
    }
    50% {
      transform: translate3d(var(--sway), -55vh, 0);
    }
    92% {
      opacity: 0.42;
    }
    100% {
      transform: translate3d(calc(var(--sway) * -0.6), -115vh, 0);
      opacity: 0;
    }
  }

  /* 浅色模式下金粉收敛一点，避免在奶油底上显脏 */
  :global(html:not(.dark)) .dust-p {
    animation-name: dust-rise-light;
  }
  @keyframes dust-rise-light {
    0% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
    }
    8% {
      opacity: 0.4;
    }
    50% {
      transform: translate3d(var(--sway), -55vh, 0);
    }
    92% {
      opacity: 0.26;
    }
    100% {
      transform: translate3d(calc(var(--sway) * -0.6), -115vh, 0);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dust {
      display: none;
    }
  }

  /* 移动端减少金粉数量，省电 */
  @media (max-width: 767px) {
    .dust-p:nth-child(n + 8) {
      display: none;
    }
  }
</style>
