---
/**
 * 女仆工坊缎带蝴蝶结（插件 maid-atelier 标志性装饰）。
 * 颜色走 CSS 变量：--bow-fill 环带底色（默认品牌蓝）、
 * --bow-accent 描边与中心结（默认鎏金），可被宿主覆盖。
 */
interface Props {
  width?: number;
  class?: string;
}
const { width = 120, class: cls } = Astro.props;
---

<svg
  class:list={['maid-bow', cls]}
  width={width}
  viewBox="0 0 120 66"
  fill="none"
  aria-hidden="true"
>
  <!-- 飘带尾 -->
  <path
    d="M55 40 C48 50 40 55 30 61 L43 61 C50 55 54.5 48 56.5 43 Z"
    fill="var(--bow-fill)"
    stroke="var(--bow-accent)"
    stroke-width="1.5"
    stroke-linejoin="round"></path>
  <path
    d="M65 40 C72 50 80 55 90 61 L77 61 C70 55 65.5 48 63.5 43 Z"
    fill="var(--bow-fill)"
    stroke="var(--bow-accent)"
    stroke-width="1.5"
    stroke-linejoin="round"></path>
  <!-- 双环 -->
  <path
    d="M57 32 C42 10 16 10 17 28 C18 45 44 47 57 35 Z"
    fill="var(--bow-fill)"
    stroke="var(--bow-accent)"
    stroke-width="1.8"
    stroke-linejoin="round"></path>
  <path
    d="M63 32 C78 10 104 10 103 28 C102 45 76 47 63 35 Z"
    fill="var(--bow-fill)"
    stroke="var(--bow-accent)"
    stroke-width="1.8"
    stroke-linejoin="round"></path>
  <!-- 环内高光弧 -->
  <path
    d="M49 15 C40 19 34.5 25 33 30.5"
    stroke="var(--bow-accent)"
    stroke-width="1"
    opacity="0.5"
    stroke-linecap="round"></path>
  <path
    d="M71 15 C80 19 85.5 25 87 30.5"
    stroke="var(--bow-accent)"
    stroke-width="1"
    opacity="0.5"
    stroke-linecap="round"></path>
  <!-- 中心结 -->
  <rect
    x="52"
    y="26"
    width="16"
    height="14"
    rx="5"
    fill="var(--bow-accent)"></rect>
  <circle cx="60" cy="33" r="1.6" fill="var(--bow-fill)" opacity="0.55"></circle>
</svg>

<style>
  .maid-bow {
    --bow-fill: var(--brand);
    --bow-accent: var(--gold);
    display: block;
    filter: drop-shadow(0 3px 6px rgb(15 30 72 / 0.2));
  }
</style>
