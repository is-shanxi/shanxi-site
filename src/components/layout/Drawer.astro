---
import { NAV, SOCIALS, AUTHOR } from '@/config';
import { useTranslations, type TranslationKey } from '@/i18n';
import Icon from '@/components/ui/Icon.astro';
import Avatar from '@/components/ui/Avatar.astro';

const t = useTranslations();
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<div class="drawer" data-drawer aria-hidden="true">
  <div class="drawer-scrim" data-drawer-close></div>

  <aside class="drawer-panel" role="dialog" aria-label="站点导航" aria-modal="true">
    <div class="drawer-head">
      <div class="drawer-profile">
        <Avatar size={44} />
        <div>
          <p class="drawer-name">{AUTHOR.name}</p>
          <p class="drawer-role">{AUTHOR.role}</p>
        </div>
      </div>
      <button
        type="button"
        class="drawer-close"
        data-drawer-close
        aria-label="关闭菜单"
      >
        <Icon name="close" size={18} />
      </button>
    </div>

    <nav class="drawer-nav" aria-label="移动端导航">
      {
        NAV.map((item, i) => (
          <a
            href={item.href}
            data-drawer-close
            class:list={['drawer-item', { 'is-active': isActive(item.href) }]}
            style={`--i:${i}`}
          >
            <Icon name={item.icon} size={17} />
            <span>{t(item.key as TranslationKey)}</span>
            <Icon name="arrow-right" size={15} class="drawer-arrow" />
          </a>
        ))
      }
    </nav>

    <div class="drawer-socials">
      {
        SOCIALS.map((s) =>
          s.displayOnly ? (
            <span class="social-btn" title={s.hint} aria-label={s.label}>
              <Icon name={s.icon} size={17} />
            </span>
          ) : (
            <a
              class="social-btn"
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel="noopener noreferrer"
              aria-label={s.label}
            >
              <Icon name={s.icon} size={17} />
            </a>
          ),
        )
      }
    </div>
  </aside>
</div>

<style>
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 90;
    visibility: hidden;
    pointer-events: none;
  }
  .drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .drawer-scrim {
    position: absolute;
    inset: 0;
    background: rgb(8 18 46 / 0.5);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-soft);
  }
  .drawer.is-open .drawer-scrim {
    opacity: 1;
  }

  .drawer-panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: min(310px, 84vw);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.1rem;
    background: var(--surface);
    border-inline-start: 1px solid color-mix(in oklab, var(--gold) 36%, var(--border));
    box-shadow: var(--shadow-lg);
    transform: translateX(100%);
    transition: transform var(--dur-slow) var(--ease-soft);
    overflow-y: auto;
  }
  /* 抽屉侧栏：深海藏蓝纵向渐变 */
  .dark .drawer-panel {
    background: linear-gradient(
      180deg,
      rgb(24 40 72 / 0.88),
      rgb(15 32 64 / 0.96)
    );
  }
  .drawer.is-open .drawer-panel {
    transform: none;
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .drawer-profile {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .drawer-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
  }
  .drawer-role {
    font-size: 0.74rem;
    color: var(--text-subtle);
  }
  .drawer-close {
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: var(--r-full);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-soft);
  }
  .drawer-close:hover {
    color: var(--brand);
    border-color: var(--brand);
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .drawer-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.85rem;
    border-radius: var(--r-md);
    font-weight: 550;
    font-size: 0.92rem;
    color: var(--text-muted);
    transition: all var(--dur) var(--ease-soft);
  }
  .drawer.is-open .drawer-item {
    animation: drawer-item-in 420ms var(--ease-soft) both;
    animation-delay: calc(var(--i) * 45ms + 90ms);
  }
  @keyframes drawer-item-in {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
  }
  .drawer-item:hover {
    background: var(--bg-soft);
    color: var(--text);
  }
  .drawer-item.is-active {
    background: var(--brand-soft);
    color: var(--brand-hover);
  }
  .drawer-arrow {
    margin-inline-start: auto;
    opacity: 0;
    transform: translateX(-6px);
    transition: all var(--dur) var(--ease-soft);
  }
  .drawer-item:hover .drawer-arrow,
  .drawer-item.is-active .drawer-arrow {
    opacity: 0.7;
    transform: none;
  }

  .drawer-socials {
    margin-block-start: auto;
    display: flex;
    gap: 0.45rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--border);
  }
  .social-btn {
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: var(--r-full);
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: all var(--dur) var(--ease-soft);
  }
  .social-btn:hover {
    color: var(--brand-hover);
    border-color: var(--brand);
    background: var(--brand-soft);
    transform: translateY(-2px);
  }

  @media (min-width: 1024px) {
    .drawer {
      display: none;
    }
  }
</style>
